/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDC_GAMESERVER MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "All User LogOut",             IDM_FILE_ALLUSERLOGOUT
        MENUITEM "All User Disconnect",         IDM_FILE_ALLUSERDISCONNECT
        MENUITEM SEPARATOR
        MENUITEM "1 Minute(s) Server Close",    IDM_FILE_1MINUTESERVERCLOSE
        MENUITEM "3 Minute(s) Server Close",    IDM_FILE_3MINUTESERVERCLOSE
        MENUITEM "5 Minute(s) Server Close",    IDM_FILE_5MINUTESERVERCLOSE
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       IDM_EXIT
    END
    POPUP "Reload"
    BEGIN
        MENUITEM "Reload CashShop",             IDM_RELOAD_RELOADCASHSHOP
        MENUITEM "Reload ChaosMix",             IDM_RELOAD_RELOADCHAOSMIX
        MENUITEM "Reload Character",            IDM_RELOAD_RELOADCHARACTER
        MENUITEM "Reload Command",              IDM_RELOAD_RELOADCOMMAND
        MENUITEM "Reload Common",               IDM_RELOAD_RELOADCOMMON
        MENUITEM "Reload Custom",               IDM_RELOAD_RELOADCUSTOM
        MENUITEM "Reload Event",                IDM_RELOAD_RELOADEVENT
        MENUITEM "Reload EventItemBag",         IDM_RELOAD_RELOADEVENTITEMBAG
        MENUITEM "Reload Hack",                 IDM_RELOAD_RELOADHACK
        MENUITEM "Reload Item",                 IDM_RELOAD_RELOADITEM
        MENUITEM "Reload Monster",              IDM_RELOAD_RELOADMONSTER
        MENUITEM "Reload Move",                 IDM_RELOAD_RELOADMOVE
        MENUITEM "Reload Quest",                IDM_RELOAD_RELOADQUEST
        MENUITEM "Reload Shop",                 IDM_RELOAD_RELOADSHOP
        MENUITEM "Reload Skill",                IDM_RELOAD_RELOADSKILL
        MENUITEM "Reload Util",                 IDM_RELOAD_RELOADUTIL
        MENUITEM "Reload Bots",                 IDM_RELOAD_RELOADBOTS
        MENUITEM "Reload All",                  IDM_RELOAD_RELOADALL
        MENUITEM "Make BOT Online",             IDM_FAKEONLINE_MAKE
        MENUITEM "Close BOT Online",            IDM_FAKEONLINE_CLOSE
    END
    POPUP "Events"
    BEGIN
        POPUP "Start OnlineLottery"
        BEGIN
            MENUITEM "Lorencia",                    IDM_STARTONLINELOTTERY_LORENCIA
            MENUITEM "Devias",                      IDM_STARTONLINELOTTERY_DEVIAS
            MENUITEM "Noria",                       IDM_STARTONLINELOTTERY_NORIA
            MENUITEM "Elbeland",                    IDM_STARTONLINELOTTERY_ELBELAND
        END
        MENUITEM "Start Blood Castle",          IDM_STARTBC
        MENUITEM "Start Devil Square",          IDM_STARTDS
        MENUITEM "Start Chaos Castle",          IDM_STARTCC
        MENUITEM "Start Illusion Temple",       IDM_STARTIT
        MENUITEM "Start Quiz",                  IDM_STARTQUIZ
        MENUITEM "Start Drop",                  IDM_STARTDROP
        MENUITEM "Start King of Mu",            IDM_STARTKING
        MENUITEM "Start Team vs Team",          IDM_STARTTVT
        MENUITEM "Start Guild vs Guild",        IDM_STARTGVG
        MENUITEM "Start Castle Siege (GSCS)",   IDM_STARTCS
        MENUITEM "Start Cry Wolf (GSCS)",       IDM_STARTCW
        MENUITEM "Start Loren Deep (GSCS)",     IDM_STARTLD
        MENUITEM "Start Find Path To Npc",      IDM_STARTFINDPATHTONPC
    END
    POPUP "Invasion"
    BEGIN
        MENUITEM "Start Index 0 (Skeleton King)", IDM_INVASION0
        MENUITEM "Start Index 1 (Red Dragon)",  IDM_INVASION1
        MENUITEM "Start Index 2 (Golden Dragon)", IDM_INVASION2
        MENUITEM "Start Index 3 (White Wizard)", IDM_INVASION3
        MENUITEM "Start Index 4 (New Year)",    IDM_INVASION4
        MENUITEM "Start Index 5 (Rabbits)",     IDM_INVASION5
        MENUITEM "Start Index 6 (Summer)",      IDM_INVASION6
        MENUITEM "Start Index 7 (Cursed Santa)", IDM_INVASION7
        MENUITEM "Start Index 8 (Medusa(S6+))", IDM_INVASION8
        MENUITEM "Start Index 9 (Demons(S8+))", IDM_INVASION9
        MENUITEM "Start Index 10(Eggs(S8+))",   IDM_INVASION10
        MENUITEM "Start Index 11(Custom 1)",    IDM_INVASION11
        MENUITEM "Start Index 12(Custom 2)",    IDM_INVASION12
        MENUITEM "Start Index 13(Custom 3)",    IDM_INVASION13
    END
    POPUP "Custom Arena"
    BEGIN
        MENUITEM "Start Index 0",               IDM_CA0
        MENUITEM "Start Index 1",               IDM_CA1
        MENUITEM "Start Index 2",               IDM_CA2
        MENUITEM "Start Index 3",               IDM_CA3
        MENUITEM "Start Index 4",               IDM_CA4
        MENUITEM "Start Index 5",               IDM_CA5
        MENUITEM "Start Index 6",               IDM_CA6
        MENUITEM "Start Index 7",               IDM_CA7
        MENUITEM "Start Index 8",               IDM_CA8
        MENUITEM "Start Index 9",               IDM_CA9
        MENUITEM "Start Index 10",              IDM_CA10
        MENUITEM "Start Index 11",              IDM_CA11
        MENUITEM "Start Index 12",              IDM_CA12
        MENUITEM "Start Index 13",              IDM_CA13
    END
    POPUP "Tools"
    BEGIN
        MENUITEM "Online Users",                IDM_ONLINEUSERS
        MENUITEM "Export BMD",                  ID_TOOLS_EXPORTITEM
        MENUITEM "Export XML",                  ID_TOOLS_EXPORTXML
    END

    POPUP "User Manager"
    BEGIN
        MENUITEM "Online Users",                IDM_ONLINEUSERS
    END

    //==============================CB_ANTIHACKGGNEW==================================//
    POPUP "LOGS"
    BEGIN
        MENUITEM "APIGameGuard",                ID_VIEWLOGHACK
    END
    //==============================End CB_ANTIHACKGGNEW==================================//

    POPUP "&Help"
    BEGIN
        MENUITEM "&About ...",                  IDM_ABOUT
    END
END


